# VPS Data Collector Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001

# Per-platform refresh intervals (in milliseconds)
# Predict.fun has strict rate limits - keep it at 60 seconds or higher!
POLYMARKET_INTERVAL=5000   # 5 seconds
PREDICTFUN_INTERVAL=60000  # 60 seconds (rate limit protection)
KALSHI_INTERVAL=10000      # 10 seconds

# Predict.fun API Key (required for Predict.fun data)
PREDICT_FUN_API_KEY=

# Kalshi RSA Authentication (required for Kalshi data)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=

# Telegram Notifications (optional - for daily top volume alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_HOURS=9,21  # KST hours to send alerts (default: 9 AM and 9 PM)
