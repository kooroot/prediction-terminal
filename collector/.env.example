# VPS Data Collector Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3001
REFRESH_INTERVAL=5000

# Predict.fun API Key (required for Predict.fun data)
PREDICT_FUN_API_KEY=

# Kalshi RSA Authentication (required for Kalshi data)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=
